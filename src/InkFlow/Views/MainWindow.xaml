<Window x:Class="InkFlow.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InkFlow.Controls"
        Title="墨流 · 码字助手"
        Width="1200" Height="790" MinWidth="1000" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBaseBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- ambient light -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="880" Height="880" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-420,-470,0,0" Fill="{DynamicResource GlowVioletBrush}" />
            <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-340" Fill="{DynamicResource GlowTealBrush}" />
        </Grid>

        <Border x:Name="Frame" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource WindowEdgeBrush}" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TitleRow" Height="66" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ============ title bar ============ -->
                <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" Margin="22,0,12,0"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource AccentGradientBrush}">
                            <TextBlock Text="墨" FontSize="17" FontWeight="SemiBold" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="墨流" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="码字助手" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource NavBackgroundBrush}" BorderBrush="{DynamicResource CardBorderSoftBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="NavWrite" Content="写作" Tag="0" GroupName="Nav" IsChecked="True"
                                         Style="{StaticResource NavTabStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavStats" Content="统计" Tag="1" GroupName="Nav"
                                         Style="{StaticResource NavTabStyle}" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSettings" Content="设置" Tag="2" GroupName="Nav"
                                         Style="{StaticResource NavTabStyle}" Checked="Nav_Checked" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButtonStyle}" Click="OverlayButton_Click"
                                ToolTip="{Binding OverlayHotkeyText, StringFormat={}显示 / 隐藏浮窗（{0}）}" Margin="0,0,2,0">
                            <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}" Click="ThemeButton_Click" ToolTip="切换深色 / 浅色主题">
                            <TextBlock x:Name="ThemeGlyph" Text="&#xE706;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" />
                        </Button>

                        <Border Width="1" Height="18" Background="{DynamicResource DividerBrush}" Margin="6,0" />

                        <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;" ToolTip="最小化" Click="MinimizeButton_Click" />
                        <Button x:Name="MaxButton" Style="{StaticResource WindowButtonStyle}" Content="&#xE922;" ToolTip="最大化" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;" ToolTip="关闭" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>

                <!-- ============ pages ============ -->
                <Grid Grid.Row="1">
                    <!-- writing page -->
                    <Grid x:Name="PageWrite" Margin="18,0,18,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SideColumn" Width="344" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="EditorCard" Grid.Column="0" Margin="0,0,14,0" Style="{StaticResource CardStyle}"
                                Padding="0" Background="{DynamicResource EditorSurfaceBrush}" CornerRadius="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="72" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="44" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="26,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DocumentTitle}" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource GoldSoftBrush}" CornerRadius="5" Padding="6,2" Margin="9,1,0,0"
                                                    VerticalAlignment="Center" Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="未保存" FontSize="9" Foreground="{DynamicResource GoldBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DocumentPath}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DocumentPath}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE8B7;" ToolTip="打开文稿（Ctrl+O）" Click="OpenButton_Click" />
                                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE74E;" ToolTip="保存（Ctrl+S）" Click="SaveButton_Click" Margin="4,0" />
                                        <Button Style="{StaticResource IconButtonStyle}" Content="&#xE740;" ToolTip="专注模式（F11）" Click="FocusButton_Click" Margin="4,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Row="1" Margin="16,2,6,0">
                                    <RichTextBox x:Name="Editor"
                                                 Background="Transparent" BorderThickness="0" Padding="8,4,18,24"
                                                 FontFamily="{Binding Settings.EditorFont}"
                                                 FontSize="{Binding Settings.EditorFontSize}"
                                                 Foreground="{DynamicResource EditorTextBrush}"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 SelectionBrush="{DynamicResource SelectionBrush}" SelectionOpacity="0.32"
                                                 AcceptsTab="True" AcceptsReturn="True" SpellCheck.IsEnabled="False"
                                                 IsDocumentEnabled="False" UndoLimit="300"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                 AllowDrop="True" Drop="Editor_Drop"
                                                 TextChanged="Editor_TextChanged"
                                                 PreviewKeyDown="Editor_PreviewKeyDown"
                                                 PreviewMouseWheel="Editor_PreviewMouseWheel" />
                                    <TextBlock x:Name="PlaceholderText" Text="在这里写下今天的第一句……"
                                               FontFamily="{Binding Settings.EditorFont}" FontSize="{Binding Settings.EditorFontSize}"
                                               Foreground="{DynamicResource PlaceholderBrush}" Margin="10,6,0,0"
                                               IsHitTestVisible="False" TextWrapping="Wrap" />
                                </Grid>

                                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerBrush}" Padding="26,0,20,0">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentCountText}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,0" />
                                            <TextBlock Text="{Binding ParagraphText}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="·" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,0" />
                                            <TextBlock Text="{Binding Engine.GoalPercent, StringFormat={}今日目标 {0}%}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Accent2Brush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource GoldBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding SaveStatusText}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Column="1" x:Name="SidePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,2,4">
                                <!-- today goal -->
                                <Border Style="{StaticResource CardStyle}" Padding="20,18">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="今日目标" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StreakText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Height="168" Margin="0,4,0,0">
                                            <controls:ProgressRing Width="156" Height="156" Thickness="10"
                                                                   Value="{Binding Engine.GoalFraction}"
                                                                   TrackBrush="{DynamicResource RingTrackBrush}"
                                                                   ProgressBrush="{DynamicResource AccentGradientBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Engine.WordsToday, StringFormat={}{0:N0}}" Style="{StaticResource BigNumberText}"
                                                           HorizontalAlignment="Center" />
                                                <TextBlock Text="今日字数" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" Margin="0,1,0,0" />
                                                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="20" Padding="9,2" Margin="0,8,0,0" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding Engine.GoalPercent, StringFormat={}{0}%}" FontSize="10.5"
                                                               Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,2,0,0">
                                            <TextBlock Text="{Binding GoalRemainingText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Engine.DailyGoal, StringFormat={}目标 {0:N0} 字}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- session -->
                                <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="本节数据" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                                            <Border HorizontalAlignment="Right" Background="{DynamicResource SurfaceSunkenBrush}" CornerRadius="20" Padding="8,3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource StatusPausedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Engine.StatusKind}" Value="writing">
                                                                        <Setter Property="Fill" Value="{DynamicResource StatusWritingBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Engine.StatusKind}" Value="resting">
                                                                        <Setter Property="Fill" Value="{DynamicResource StatusRestBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Engine.StatusText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="1" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                                <TextBlock Text="{Binding Engine.SessionWritingSeconds, Converter={StaticResource Clock}}" Style="{StaticResource MetricValueText}" />
                                                <TextBlock Text="码字时间" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="12,0,0,12">
                                                <TextBlock Text="{Binding Engine.SessionRestSeconds, Converter={StaticResource Clock}}" Style="{StaticResource MetricValueText}" />
                                                <TextBlock Text="休息时间" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12" />

                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="{Binding Engine.SessionWords, StringFormat={}{0:N0}}" Style="{StaticResource MetricValueText}" />
                                                <TextBlock Text="本节字数" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Engine.AverageSpeedSession, StringFormat={}{0:0}}" Style="{StaticResource MetricValueText}" />
                                                    <TextBlock Text=" 字/分" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="2,0,0,5" />
                                                </StackPanel>
                                                <TextBlock Text="平均速率" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <Border Grid.Column="1" Grid.Row="0" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,2,0,14" />
                                            <Border Grid.Column="1" Grid.Row="2" Width="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,2" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- rhythm -->
                                <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="实时节奏" Style="{StaticResource CardTitleText}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Engine.Speed, StringFormat={}{0:0}}" FontFamily="{StaticResource DisplayFontFamily}"
                                                           FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="字/分" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="3,0,0,4" />
                                            </StackPanel>
                                        </Grid>
                                        <controls:Sparkline Height="48" Margin="0,10,0,2"
                                                            Values="{Binding Engine.SpeedHistory}"
                                                            Stroke="{DynamicResource SparkStrokeBrush}"
                                                            Fill="{DynamicResource SparkFillBrush}"
                                                            StrokeThickness="2" />
                                        <TextBlock Text="{Binding Engine.BreakHintText}" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- statistics page -->
                    <Grid x:Name="PageStats" Margin="26,2,26,18" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="统计" Style="{StaticResource PageTitleText}" />
                                        <TextBlock Text="{Binding TodayDateText}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Border Style="{StaticResource PillStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{DynamicResource GoldBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding StreakText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,14">
                                    <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="今日字数" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding Engine.WordsToday, StringFormat={}{0:N0}}" Style="{StaticResource BigNumberText}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Engine.GoalPercent, StringFormat={}目标完成 {0}%}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="码字时长" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding Engine.WritingSecondsToday, Converter={StaticResource Clock}}" Style="{StaticResource BigNumberText}" Margin="0,4,0,0" />
                                            <TextBlock Text="专注写作累计" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,12,0">
                                        <StackPanel>
                                            <TextBlock Text="休息时长" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding Engine.RestSecondsToday, Converter={StaticResource Clock}}" Style="{StaticResource BigNumberText}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Engine.BreaksToday, StringFormat={}今天已休息 {0} 次}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardStyle}" Padding="18,16">
                                        <StackPanel>
                                            <TextBlock Text="平均速度" Style="{StaticResource CaptionText}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Engine.AverageSpeedToday, StringFormat={}{0:0}}" Style="{StaticResource BigNumberText}" />
                                                <TextBlock Text="字/分" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="4,0,0,9" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Engine.TodayBestSpeed, StringFormat={}最高 {0:0} 字/分}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Style="{StaticResource CardStyle}" Padding="22,18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="近 14 天字数" Style="{StaticResource CardTitleText}" />
                                                <TextBlock Text="每一根柱子都是一天的产出" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding MonthWordsText}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                <TextBlock Text="本月累计字数" Style="{StaticResource MutedText}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding RecentDays}" Margin="0,22,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="4,0" Background="Transparent" ToolTip="{Binding Tooltip}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="146" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding Value, StringFormat={}{0:N0}}" FontSize="9.5"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"
                                                                       Visibility="{Binding HasValue, Converter={StaticResource BoolToVis}}" />
                                                            <Border Width="20" Height="{Binding BarHeight}" CornerRadius="5,5,2,2">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="{DynamicResource ChartBarBrush}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource TodayBarBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardStyle}" Padding="22,18" Margin="0,0,7,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="今日节奏" Style="{StaticResource CardTitleText}" />
                                                <TextBlock Text="{Binding Engine.ContinuousWritingSeconds, Converter={StaticResource Clock}, StringFormat={}连续专注 {0}}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <controls:Sparkline Height="82" Margin="0,16,0,4"
                                                                Values="{Binding Engine.SpeedHistory}"
                                                                Stroke="{DynamicResource SparkStrokeBrush}"
                                                                Fill="{DynamicResource SparkFillBrush}"
                                                                StrokeThickness="2" />
                                            <TextBlock Text="{Binding Engine.BreakHintText}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="22,18" Margin="7,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="累计" Style="{StaticResource CardTitleText}" />
                                            <Grid Margin="0,14,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="总字数" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,7" />
                                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TotalWordsText}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="连续打卡" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,7" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StreakDays, StringFormat={}{0} 天}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Text="今日最佳" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,7" />
                                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Engine.TodayBestSpeed, StringFormat={}{0:0} 字/分}" FontFamily="{StaticResource DisplayFontFamily}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- settings page -->
                    <ScrollViewer x:Name="PageSettings" Margin="26,2,26,18" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel MaxWidth="1000" HorizontalAlignment="Center">
                            <TextBlock Text="设置" Style="{StaticResource PageTitleText}" />
                            <TextBlock Text="所有统计与文稿只保存在这台电脑上" Style="{StaticResource CaptionText}" Margin="0,5,0,18" />

                            <!-- goals -->
                            <Border Style="{StaticResource CardStyle}" Padding="22,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="目标与节奏" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="合理的节奏比一时的爆发更长久" Style="{StaticResource MutedText}" Margin="0,4,0,6" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="每日目标" Tag="达到目标后会收到一次祝贺提醒">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="GoalBox" Width="82" Style="{StaticResource InputBoxStyle}" Text="{Binding Settings.DailyGoal, Mode=OneWay}"
                                                     LostFocus="GoalBox_LostFocus" PreviewTextInput="NumericOnly_PreviewTextInput" VerticalContentAlignment="Center" />
                                            <TextBlock Text="字" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="7,0,14,0" />
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="1000" Tag="1000" GroupName="GoalChips" Style="{StaticResource ChipRadioStyle}" Click="GoalChip_Click"
                                                             IsChecked="{Binding Settings.DailyGoal, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=1000}" />
                                                <RadioButton Content="2000" Tag="2000" GroupName="GoalChips" Margin="6,0" Style="{StaticResource ChipRadioStyle}" Click="GoalChip_Click"
                                                             IsChecked="{Binding Settings.DailyGoal, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=2000}" />
                                                <RadioButton Content="3000" Tag="3000" GroupName="GoalChips" Style="{StaticResource ChipRadioStyle}" Click="GoalChip_Click"
                                                             IsChecked="{Binding Settings.DailyGoal, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=3000}" />
                                                <RadioButton Content="5000" Tag="5000" GroupName="GoalChips" Margin="6,0,0,0" Style="{StaticResource ChipRadioStyle}" Click="GoalChip_Click"
                                                             IsChecked="{Binding Settings.DailyGoal, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=5000}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="休息提醒" Tag="连续码字达到设定时长后提醒你起身活动">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="关闭" Tag="0" GroupName="BreakChips" Style="{StaticResource ChipRadioStyle}" Click="BreakChip_Click"
                                                         IsChecked="{Binding Settings.BreakReminderMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=0}" />
                                            <RadioButton Content="20 分钟" Tag="20" GroupName="BreakChips" Margin="6,0" Style="{StaticResource ChipRadioStyle}" Click="BreakChip_Click"
                                                         IsChecked="{Binding Settings.BreakReminderMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=20}" />
                                            <RadioButton Content="25 分钟" Tag="25" GroupName="BreakChips" Style="{StaticResource ChipRadioStyle}" Click="BreakChip_Click"
                                                         IsChecked="{Binding Settings.BreakReminderMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=25}" />
                                            <RadioButton Content="30 分钟" Tag="30" GroupName="BreakChips" Margin="6,0" Style="{StaticResource ChipRadioStyle}" Click="BreakChip_Click"
                                                         IsChecked="{Binding Settings.BreakReminderMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                            <RadioButton Content="45 分钟" Tag="45" GroupName="BreakChips" Style="{StaticResource ChipRadioStyle}" Click="BreakChip_Click"
                                                         IsChecked="{Binding Settings.BreakReminderMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=45}" />
                                            <RadioButton Content="60 分钟" Tag="60" GroupName="BreakChips" Margin="6,0,0,0" Style="{StaticResource ChipRadioStyle}" Click="BreakChip_Click"
                                                         IsChecked="{Binding Settings.BreakReminderMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="空闲判定" Tag="超过这个时间没有输入，就计入休息时间">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="3 秒" Tag="3" GroupName="IdleChips" Style="{StaticResource ChipRadioStyle}" Click="IdleChip_Click"
                                                         IsChecked="{Binding Settings.IdleThresholdSeconds, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=3}" />
                                            <RadioButton Content="6 秒" Tag="6" GroupName="IdleChips" Margin="6,0" Style="{StaticResource ChipRadioStyle}" Click="IdleChip_Click"
                                                         IsChecked="{Binding Settings.IdleThresholdSeconds, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=6}" />
                                            <RadioButton Content="10 秒" Tag="10" GroupName="IdleChips" Style="{StaticResource ChipRadioStyle}" Click="IdleChip_Click"
                                                         IsChecked="{Binding Settings.IdleThresholdSeconds, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                            <RadioButton Content="20 秒" Tag="20" GroupName="IdleChips" Margin="6,0,0,0" Style="{StaticResource ChipRadioStyle}" Click="IdleChip_Click"
                                                         IsChecked="{Binding Settings.IdleThresholdSeconds, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=20}" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="自动暂停" Tag="长时间没有输入时自动停下计时，下一次敲键自动恢复">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="10 分钟" Tag="10" GroupName="AutoPauseChips" Style="{StaticResource ChipRadioStyle}" Click="AutoPauseChip_Click"
                                                         IsChecked="{Binding Settings.AutoPauseMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=10}" />
                                            <RadioButton Content="30 分钟" Tag="30" GroupName="AutoPauseChips" Margin="6,0" Style="{StaticResource ChipRadioStyle}" Click="AutoPauseChip_Click"
                                                         IsChecked="{Binding Settings.AutoPauseMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=30}" />
                                            <RadioButton Content="60 分钟" Tag="60" GroupName="AutoPauseChips" Style="{StaticResource ChipRadioStyle}" Click="AutoPauseChip_Click"
                                                         IsChecked="{Binding Settings.AutoPauseMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=60}" />
                                            <RadioButton Content="不自动暂停" Tag="0" GroupName="AutoPauseChips" Margin="6,0,0,0" Style="{StaticResource ChipRadioStyle}" Click="AutoPauseChip_Click"
                                                         IsChecked="{Binding Settings.AutoPauseMinutes, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=0}" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <!-- overlay -->
                            <Border Style="{StaticResource CardStyle}" Padding="22,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="码字浮窗" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="始终置顶的小窗，随时看到码字、休息、字数与节奏" Style="{StaticResource MutedText}" Margin="0,4,0,6" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="显示浮窗" Tag="支持拖动到屏幕任意位置，位置会被记住">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.ShowOverlay}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="显示文章名" Tag="在浮窗顶部显示当前文稿名；在 Word 中写作时自动显示 Word 文档名">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.ShowOverlayDocumentName}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="锁定位置" Tag="锁定后不会因拖动而移动">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.OverlayLocked}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="鼠标穿透" Tag="浮窗只负责显示，鼠标点击会穿透到下面的窗口">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.OverlayClickThrough}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="背景不透明度" Tag="只影响浮窗的底色与边框；数值越低，背景越通透">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="200" Style="{StaticResource ModernSliderStyle}" Minimum="0.25" Maximum="1"
                                                    Value="{Binding Settings.OverlayBackgroundOpacity, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding Settings.OverlayBackgroundOpacity, Converter={StaticResource PercentText}}" Width="48"
                                                       Style="{StaticResource CaptionText}" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="文字不透明度" Tag="只影响浮窗里的文字、图标与图表；可以和背景分开调">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="200" Style="{StaticResource ModernSliderStyle}" Minimum="0.4" Maximum="1"
                                                    Value="{Binding Settings.OverlayTextOpacity, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding Settings.OverlayTextOpacity, Converter={StaticResource PercentText}}" Width="48"
                                                       Style="{StaticResource CaptionText}" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="浮窗大小" Tag="在小巧与易读之间找到平衡">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="200" Style="{StaticResource ModernSliderStyle}" Minimum="0.8" Maximum="1.3"
                                                    Value="{Binding Settings.OverlayScale, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding Settings.OverlayScale, Converter={StaticResource PercentText}}" Width="48"
                                                       Style="{StaticResource CaptionText}" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <TextBlock Text="{Binding OverlayHotkeyText, StringFormat={}快捷键：{0} 显示 / 隐藏 · Ctrl+Alt+T 鼠标穿透}"
                                               Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- editor -->
                            <Border Style="{StaticResource CardStyle}" Padding="22,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="编辑器" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="专注于文字本身，其余交给墨流" Style="{StaticResource MutedText}" Margin="0,4,0,6" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="字体" Tag="选择让你写得最舒服的字体">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="雅黑" Tag="Microsoft YaHei UI" GroupName="FontChips" Style="{StaticResource ChipRadioStyle}" Click="FontChip_Click"
                                                         IsChecked="{Binding Settings.EditorFont, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter='Microsoft YaHei UI'}" />
                                            <RadioButton Content="宋体" Tag="SimSun" GroupName="FontChips" Margin="6,0" Style="{StaticResource ChipRadioStyle}" Click="FontChip_Click"
                                                         IsChecked="{Binding Settings.EditorFont, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=SimSun}" />
                                            <RadioButton Content="楷体" Tag="KaiTi" GroupName="FontChips" Style="{StaticResource ChipRadioStyle}" Click="FontChip_Click"
                                                         IsChecked="{Binding Settings.EditorFont, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=KaiTi}" />
                                            <RadioButton Content="等宽" Tag="Consolas" GroupName="FontChips" Margin="6,0,0,0" Style="{StaticResource ChipRadioStyle}" Click="FontChip_Click"
                                                         IsChecked="{Binding Settings.EditorFont, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Consolas}" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="字号" Tag="Ctrl + 滚轮可以在编辑器里快速调整">
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="200" Style="{StaticResource ModernSliderStyle}" Minimum="13" Maximum="26" TickFrequency="0.5"
                                                    Value="{Binding Settings.EditorFontSize, Mode=TwoWay}" />
                                            <TextBlock Text="{Binding Settings.EditorFontSize, StringFormat={}{0:0.#} pt}" Width="56"
                                                       Style="{StaticResource CaptionText}" TextAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="草稿目录" Tag="{Binding DraftDirectory}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="更改…" Style="{StaticResource SubtleButtonStyle}" Click="ChangeDraftFolder_Click" Padding="12,7" />
                                            <Button Content="打开文件夹" Style="{StaticResource SubtleButtonStyle}" Click="OpenDraftFolder_Click" Padding="12,7" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <TextBlock Text="文稿会自动保存，每 2 秒一次；关闭窗口不会打断浮窗计时。"
                                               Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- appearance and system -->
                            <Border Style="{StaticResource CardStyle}" Padding="22,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="外观与系统" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="让工具融入你的写作环境" Style="{StaticResource MutedText}" Margin="0,4,0,6" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="主题" Tag="深色适合夜间，浅色像一张温和的纸">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="深色" Tag="Dark" GroupName="ThemeChips" Style="{StaticResource ChipRadioStyle}" Click="ThemeChip_Click"
                                                         IsChecked="{Binding Settings.Theme, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Dark}" />
                                            <RadioButton Content="浅色" Tag="Light" GroupName="ThemeChips" Margin="6,0,0,0" Style="{StaticResource ChipRadioStyle}" Click="ThemeChip_Click"
                                                         IsChecked="{Binding Settings.Theme, Mode=OneWay, Converter={StaticResource Equals}, ConverterParameter=Light}" />
                                        </StackPanel>
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="提示音" Tag="休息提醒与目标达成时播放轻提示音">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.SoundEnabled}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="关闭到托盘" Tag="点击关闭按钮时收进托盘，计时继续">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.CloseToTray}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="全局按键监听" Tag="在 Word、Typora 等软件里码字时，也能统计码字与休息时间。只读取按键动作，不记录内容">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.GlobalTracking}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="Word 字数追踪" Tag="Word 桌面版在前台时，读取当前文档的字数统计并同步到浮窗；只读统计，不读正文。需要 Word 正在运行，WPS 暂不支持">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.WordTracking}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="TXT 字数追踪" Tag="在记事本、Notepad++、WordPad 等纯文本编辑器里统计字数；只读取当前编辑器文本用于本地计数，不上传。VS Code 暂不支持">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.PlainTextTracking}" />
                                    </HeaderedContentControl>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4" />

                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="外部字数估算" Tag="按按键估算其他软件的字数，中文输入法下会偏多，默认关闭；Word / TXT 请用上面的精确追踪">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.ExternalKeyEstimate}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <!-- hotkeys -->
                            <Border Style="{StaticResource CardStyle}" Padding="22,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="快捷键" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="{Binding HotkeyWarningText}" Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,6,0,0"
                                               Visibility="{Binding HotkeyWarningText, Converter={StaticResource NotEmptyToVis}}" />
                                    <HeaderedContentControl Style="{StaticResource SettingRowStyle}" Header="启用全局快捷键" Tag="与其他软件的快捷键冲突时可以关闭">
                                        <CheckBox Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.HotkeysEnabled}" />
                                    </HeaderedContentControl>
                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4,0,8" />
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                            <Grid Margin="0,5"><TextBlock Text="显示 / 隐藏浮窗" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding OverlayHotkeyText}" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></Grid>
                                            <Grid Margin="0,5"><TextBlock Text="浮窗鼠标穿透" Style="{StaticResource CaptionText}" /><TextBlock Text="Ctrl + Alt + T" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></Grid>
                                            <Grid Margin="0,5"><TextBlock Text="暂停 / 继续计时" Style="{StaticResource CaptionText}" /><TextBlock Text="Ctrl + Alt + Space" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Grid Margin="0,5"><TextBlock Text="打开主界面" Style="{StaticResource CaptionText}" /><TextBlock Text="Ctrl + Alt + M" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></Grid>
                                            <Grid Margin="0,5"><TextBlock Text="保存文稿" Style="{StaticResource CaptionText}" /><TextBlock Text="Ctrl + S" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></Grid>
                                            <Grid Margin="0,5"><TextBlock Text="专注模式" Style="{StaticResource CaptionText}" /><TextBlock Text="F11 / Esc 退出" HorizontalAlignment="Right" Style="{StaticResource MutedText}" /></Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- data -->
                            <Border Style="{StaticResource CardStyle}" Padding="22,16">
                                <StackPanel>
                                    <TextBlock Text="数据" Style="{StaticResource CardTitleText}" />
                                    <TextBlock Text="数据都保存在本机，不会上传到任何服务器" Style="{StaticResource MutedText}" Margin="0,4,0,10" />

                                    <Grid Margin="0,2,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="数据目录" Style="{StaticResource CaptionText}" />
                                            <TextBlock Text="{Binding DataDirectory}" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="打开数据目录" Style="{StaticResource SubtleButtonStyle}" Click="OpenDataFolder_Click" Padding="12,7" />
                                    </Grid>

                                    <Border Style="{StaticResource DividerStyle}" Margin="0,4,0,10" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="开始新的一节" Style="{StaticResource SubtleButtonStyle}" Click="NewSessionButton_Click" />
                                        <Button Content="重置本节" Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0" Click="ResetSessionButton_Click" />
                                        <Button Content="清空今日数据" Style="{StaticResource SubtleButtonStyle}" Margin="8,0,0,0" Foreground="{DynamicResource DangerBrush}" Click="ClearTodayButton_Click" />
                                    </StackPanel>

                                    <TextBlock Text="墨流 1.0.0 · InkFlow" Style="{StaticResource MutedText}" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="FocusExitButton" Content="退出专注" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,18,150,0" Padding="10,5" FontSize="10.5" Visibility="Collapsed" Click="ExitFocus_Click" />
        <TextBlock x:Name="FocusHint" Text="专注模式 · 按 Esc 退出" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
