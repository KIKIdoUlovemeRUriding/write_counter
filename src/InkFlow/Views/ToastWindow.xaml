<Window x:Class="InkFlow.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="墨流提醒"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        Focusable="False" FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="26">
        <Border x:Name="Card" CornerRadius="16" Padding="16,13"
                Background="{DynamicResource ToastBackgroundBrush}"
                BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Direction="270" Opacity="0.36" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="2" Margin="0,1,13,1"
                        Background="{DynamicResource AccentBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="MessageText" FontSize="11.5" LineHeight="18" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
