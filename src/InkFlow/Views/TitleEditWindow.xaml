<Window x:Class="InkFlow.Views.TitleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改浮窗标题"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" ShowActivated="True"
        FontFamily="{StaticResource UiFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Grid Margin="16">
        <Border x:Name="EditorCard" CornerRadius="16" Background="{DynamicResource OverlayBackgroundBrush}"
                BorderBrush="{DynamicResource OverlayBorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.4" Color="#000000" />
            </Border.Effect>

            <StackPanel Margin="18,14,18,14">
                <TextBlock Text="修改浮窗标题" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox x:Name="TitleBox" Style="{StaticResource InputBoxStyle}" Height="40"
                         FontSize="14" Margin="0,10,0,8" MaxLength="60"
                         KeyDown="TitleBox_KeyDown" />
                <TextBlock Text="Enter 保存 · Esc 取消 · 留空恢复自动跟随"
                           FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="保存后标题固定，不再自动跟随文档名；只改浮窗显示，不改文件名或 Word 文档名"
                           FontSize="9.5" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
