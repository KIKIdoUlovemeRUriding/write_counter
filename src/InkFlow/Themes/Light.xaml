<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==== Light palette · "Warm Paper" ==== -->
    <SolidColorBrush x:Key="WindowBaseBrush" Color="#F4F1E9" />
    <SolidColorBrush x:Key="WindowEdgeBrush" Color="#DED7C9" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#FFFDF8" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F4EFE5" />
    <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#EBE5D7" />
    <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F7F3EA" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E6E0D2" />
    <SolidColorBrush x:Key="CardBorderSoftBrush" Color="#EFEAE0" />
    <SolidColorBrush x:Key="DividerBrush" Color="#ECE6DA" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1C2029" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5F6879" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#959DA9" />

    <SolidColorBrush x:Key="AccentBrush" Color="#6355E8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDEAFE" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#556355E8" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#DCD7FB" />
    <SolidColorBrush x:Key="Accent2Brush" Color="#0E9D81" />
    <SolidColorBrush x:Key="Accent2SoftBrush" Color="#E1F5EE" />
    <SolidColorBrush x:Key="GoldBrush" Color="#B07216" />
    <SolidColorBrush x:Key="GoldSoftBrush" Color="#F9EFD9" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D6455B" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FCE8EB" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B92F45" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6355E8" Offset="0" />
        <GradientStop Color="#4E86E8" Offset="0.48" />
        <GradientStop Color="#0E9D81" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7062F0" Offset="0" />
        <GradientStop Color="#5546D8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TodayBarBrush" StartPoint="0,1" EndPoint="0,0">
        <GradientStop Color="#5546D8" Offset="0" />
        <GradientStop Color="#7566F2" Offset="0.55" />
        <GradientStop Color="#17B394" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="RingTrackBrush" Color="#ECE6D9" />
    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#FBF8F1" />
    <SolidColorBrush x:Key="EditorSurfaceBrush" Color="#FFFDF8" />
    <SolidColorBrush x:Key="EditorTextBrush" Color="#232732" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#B2AFA5" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#6355E8" />

    <SolidColorBrush x:Key="SliderTrackBrush" Color="#E6E0D2" />
    <SolidColorBrush x:Key="ThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ThumbBorderBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="SwitchTrackOffBrush" Color="#DED7C8" />
    <SolidColorBrush x:Key="SwitchThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SwitchBorderBrush" Color="#CFC7B6" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#ECE6D9" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9C2B4" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#ADA596" />

    <LinearGradientBrush x:Key="OverlayBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7FFFEFB" Offset="0" />
        <GradientStop Color="#F6F6F1E6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#22000000" />
    <LinearGradientBrush x:Key="OverlaySheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#B3FFFFFF" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#FAFFFFFF" />
    <SolidColorBrush x:Key="ToastBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="ChartBarBrush" Color="#EAE4D7" />
    <SolidColorBrush x:Key="ChartBarTodayBrush" Color="#6355E8" />
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#FCFFFFFF" />
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#DAD3C4" />

    <SolidColorBrush x:Key="IconButtonHoverBrush" Color="#F0EBE0" />
    <SolidColorBrush x:Key="WindowControlForegroundBrush" Color="#737C8A" />
    <SolidColorBrush x:Key="StatusWritingBrush" Color="#0E9D81" />
    <SolidColorBrush x:Key="StatusRestBrush" Color="#B07216" />
    <SolidColorBrush x:Key="StatusPausedBrush" Color="#8A93A1" />
    <SolidColorBrush x:Key="OverlayTextSoftBrush" Color="#5F6879" />

    <RadialGradientBrush x:Key="GlowVioletBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2E8B7CFF" Offset="0" />
        <GradientStop Color="#088B7CFF" Offset="0.62" />
        <GradientStop Color="#008B7CFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowTealBrush" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#223DDCB4" Offset="0" />
        <GradientStop Color="#063DDCB4" Offset="0.6" />
        <GradientStop Color="#003DDCB4" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="SparkStrokeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6355E8" Offset="0" />
        <GradientStop Color="#0E9D81" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SparkFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#306355E8" Offset="0" />
        <GradientStop Color="#006355E8" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
