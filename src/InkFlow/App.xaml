<Application x:Class="InkFlow.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:InkFlow.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:SecondsToClockConverter x:Key="Clock" />
            <conv:DoubleToPercentTextConverter x:Key="PercentText" />
            <conv:EqualsParameterConverter x:Key="Equals" />
            <conv:ScaleTransformConverter x:Key="ScaleTransform" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
